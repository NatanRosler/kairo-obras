# Copie para .env.local quando o login existir (veja docs/ROTEIRO.md).
# Valores em Supabase → Project Settings → API. A chave pode ser a "publishable"
# (sb_publishable_...) ou a "anon" antiga. As duas são públicas por natureza:
# a proteção dos dados é o RLS do banco. Nunca use a chave "service_role" aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
